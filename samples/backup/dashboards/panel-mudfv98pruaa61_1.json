      {
        "id": "ds_mudfxsri6",
        "name": "stock-analysis",
        "scope": "local",
        "source_type": "query",
        "connection": "postgres-odbc",
        "inline_sql": "SELECT DISTINCT\n    symbol,\n    MAX(close) OVER (PARTITION BY symbol) AS max_close,\n    FIRST_VALUE(date) OVER (\n        PARTITION BY symbol ORDER BY close DESC, date ASC\n        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING\n    ) AS max_close_date,\n    MIN(close) OVER (PARTITION BY symbol) AS min_close,\n    FIRST_VALUE(date) OVER (\n        PARTITION BY symbol ORDER BY close ASC, date ASC\n        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING\n    ) AS min_close_date,\n    FIRST_VALUE(date) OVER (\n        PARTITION BY symbol ORDER BY date DESC\n        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING\n    ) AS last_date,\n    FIRST_VALUE(close) OVER (\n        PARTITION BY symbol ORDER BY date DESC\n        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING\n    ) AS last_close,\n    COUNT(*) OVER (PARTITION BY symbol) AS total_quotes\nFROM stocks\nORDER BY symbol;\n",
        "action": "",
        "object_key": "",
        "file_expression": "",
        "renderer_type": "none",
        "renderer_config": {},
        "default_params": {}
      }
