# Copy to docker/.env. Required:
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Encrypts stored connection credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes existing saved connection secrets unreadable.
BREADBOARD_CONNECTION_SECRET_KEY=

# Optional (defaults shown)
BREADBOARD_PORT=8000
DJANGO_ALLOWED_HOSTS=*
# Add your public origin(s) if you serve the app from another host/port/https.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# First-run admin, created only if it doesn't exist yet:
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin

# Sample database (samples/db)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=example
SAMPLE_SCHEMA=samples
DOCKER_IMAGE_TAG=sample-db
